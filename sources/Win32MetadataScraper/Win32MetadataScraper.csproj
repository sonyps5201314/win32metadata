<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WarningLevel>5</WarningLevel>
    <NoWarn>1701;1702;</NoWarn>
    <ClangSharpSourceRoot Condition="'$(ClangSharpSourceRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\ClangSharp</ClangSharpSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ClangSharpSourceRoot)\sources\ClangSharp.PInvokeGenerator\ClangSharp.PInvokeGenerator.csproj" />
  </ItemGroup>

</Project>
